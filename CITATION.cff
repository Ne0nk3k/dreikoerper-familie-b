cff-version: 1.2.0
message: "If you use these orbits, please cite them as below."
title: "Family B: a linearly stable family of planar periodic three-body orbits whose topology is not in the published lists"
type: dataset
authors:
  - family-names: Habl
    given-names: Felix
repository-code: "https://github.com/Ne0nk3k/dreikoerper-familie-b"
version: "1.0.0"
license:
